{
  "name": "rhino-frontend",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "prepare": "husky",
    "pre-commit": "sh .husky/pre-commit",
    "build": "lerna run build",
    "build:webapp": "lerna run build --scope=@app/webapp",
    "build:packages": "lerna run build --scope=@rhino/*",
    "lint": "lerna run lint",
    "lint-staged": "lint-staged",
    "clean": "lerna run clean",
    "watch": "lerna watch -- lerna run build --since --parallel",
    "app:webapp:dev": "lerna run dev --scope=@app/webapp",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:ui": "lerna run test:ui",
    "test:ui:packages": "lerna run test:ui --scope=@rhino/*",
    "test:ui:packages:update-snapshot": "lerna run test:ui:update-snapshot --scope=@rhino/*",
    "test:ui:prepare:packages": "lerna run test:ui:prepare --scope=@rhino/*"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.1.1",
    "@mantine/core": "^8.2.1",
    "@mantine/dates": "^8.2.1",
    "@mantine/dropzone": "^8.2.1",
    "@mantine/form": "^8.2.1",
    "@mantine/hooks": "^8.2.1",
    "@mantine/modals": "^8.2.1",
    "@reduxjs/toolkit": "^2.2.3",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-query": "^5.32.1",
    "@tanstack/react-table": "^8.21.2",
    "axios": "^1.6.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "i18next": "^24.2.3",
    "localforage": "^1.10.0",
    "lz-string": "^1.5.0",
    "match-sorter": "^6.3.4",
    "moment-timezone": "^0.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.0",
    "react-i18next": "^15.4.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.23.0",
    "react-toastify": "^11.0.5",
    "redux-saga": "^1.3.0",
    "sort-by": "^0.0.2",
    "zod": "^4.0.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.3.3",
    "@eslint/js": "^9.9.0",
    "@storybook/addon-essentials": "^8.6.8",
    "@storybook/addon-interactions": "^8.6.8",
    "@storybook/addon-links": "^8.6.8",
    "@storybook/addon-onboarding": "^8.6.8",
    "@storybook/blocks": "^8.6.8",
    "@storybook/react": "^8.6.8",
    "@storybook/react-vite": "^8.6.8",
    "@storybook/test": "^8.6.8",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/eslint-plugin-query": "^5.59.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-storybook": "^0.8.0",
    "globals": "^15.9.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lerna": "^8.1.8",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.2.5",
    "prettier-plugin-organize-imports": "^4.1.0",
    "storybook": "^8.0.9",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^6.2.2",
    "vite-plugin-dts": "^4.1.0",
    "vitest": "^3.0.9"
  },
  "version": "1.20.1"
}
