{
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "plugins": ["prettier-plugin-organize-imports"],
  "overrides": [
    {
      "files": "*.{yaml,yml}",
      "options": {
        "singleQuote": false,
        "tabWidth": 2,
        "bracketSpacing": false,
        "proseWrap": "preserve"
      }
    }
  ]
}
